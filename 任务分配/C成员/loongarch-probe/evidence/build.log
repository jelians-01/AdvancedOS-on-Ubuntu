## compiler
loongarch64-unknown-linux-gnu-gcc (GCC) 13.0.0 20220906 (experimental)

## build
rm -rf build
mkdir -p build
loongarch64-unknown-linux-gnu-gcc -march=loongarch64 -mabi=lp64d -ffreestanding -fno-pie -fno-stack-protector -fno-asynchronous-unwind-tables -fno-builtin -O2 -Wall -Wextra -c start.c -o build/start.o
loongarch64-unknown-linux-gnu-gcc -nostdlib -nostartfiles -nodefaultlibs -static -no-pie -Wl,--build-id=none -Wl,-T,linker.ld build/start.o -o build/loongarch-probe.elf
loongarch64-unknown-linux-gnu-objcopy -O binary build/loongarch-probe.elf build/loongarch-probe.bin
loongarch64-unknown-linux-gnu-objdump -d -S build/loongarch-probe.elf > build/loongarch-probe.dis

